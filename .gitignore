# Ambiente
.env

# Registri e cache dell'applicazione
/storage/logs/*
!/storage/logs/.gitkeep
/storage/mail/*
!/storage/mail/.gitkeep

# Sistema
.DS_Store
Thumbs.db

# Pacchetti per il server: si rigenerano con tools/build-release.php
/dist/
# La versione del pacchetto: la scrive tools/build-release.php dentro lo .zip
/config/versione.php

# Le modifiche fatte dall'area riservata e le richieste arrivate dal sito:
# stanno sul server, non nel repository
/storage/data/
/storage/sessions/
/public/assets/media/
