# Arco del Vento — variabili d'ambiente.
# Copia questo file in «.env» e compila i valori. Il file .env non va mai
# versionato né caricato in un archivio pubblico: contiene credenziali.
#
#     cp .env.example .env
#
# Su Hostinger: le stesse chiavi si possono impostare anche dal pannello,
# oppure lasciando il file .env fuori dalla cartella public_html.

# ------------------------------------------------------------ Pubblicazione
# Gettone per eseguire tools/preflight.php dal browser, quando non si ha
# accesso alla riga di comando. Lascialo vuoto se non ti serve: senza gettone
# il controllo dal browser è rifiutato.
PREFLIGHT_TOKEN=

# --------------------------------------------------------------- Applicazione
APP_ENV=development          # development | production
APP_DEBUG=true               # in produzione: false

# L'indirizzo del sito, senza barra finale. Se il sito sta in una cartella,
# la cartella fa parte dell'indirizzo, e il sito si regola da solo:
#   in prova:        APP_URL=https://blackout.in/assisiapartment
#   sul dominio vero: APP_URL=https://arcodelvento.it
# Per spostarlo dall'uno all'altro si cambia questa riga, e basta.
APP_URL=http://localhost:8080

# true su una copia di prova: nessuna pagina finisce nei motori di ricerca.
# Sul dominio vero va tolta, o messa a false.
APP_NOINDEX=false

APP_DEFAULT_LOCALE=it
APP_LOCALES=it,en            # aggiungere «es» quando le traduzioni sono pronte

# ------------------------------------------------------- Area riservata
# Il codice per creare l'account dell'area riservata (/admin), la prima volta.
# Una parola lunga e casuale, almeno 16 caratteri: chi la conosce ha già
# accesso ai file del sito. Creato l'account, si svuota.
ADMIN_SETUP_TOKEN=

# --------------------------------------------------------- Dati del titolare
# Il codice fiscale del titolare, se serve all'uso amministrativo. Sta qui e
# non in content/settings.php perché quel file è versionato e finisce su
# GitHub, dove una cronologia non si ripulisce più. Il sito non lo stampa in
# nessuna pagina, in nessuna lingua: per una ditta individuale la partita IVA
# basta, e il codice fiscale di una persona è un dato personale.
OWNER_TAX_CODE=

# ------------------------------------------------------------------- Database
# Lasciare DB_DSN vuoto per far girare il sito sui contenuti in content/*.php
# (è la modalità del prototipo). Compilarlo attiva i repository su MySQL.
# Hostinger fornisce host, nome del database e utente dal pannello hPanel.
DB_DSN=
# DB_DSN=mysql:host=localhost;dbname=arcodelvento;charset=utf8mb4
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------- Prenotazioni
# demo   = provider dimostrativo incluso (nessuna chiamata di rete)
# api    = provider esterno, da implementare in src/Booking/
BOOKING_PROVIDER=demo
BOOKING_API_BASE_URL=
BOOKING_API_KEY=
BOOKING_PROPERTY_ID=
# Vuota: comanda content/settings.php (1 notte, 2 col sabato). Si riempie solo
# se un gestionale impone un altro minimo. Il commento va SOPRA e non in coda:
# in coda a una chiave vuota finirebbe dentro il valore.
BOOKING_MIN_NIGHTS=
BOOKING_CURRENCY=EUR

# ---------------------------------------------------------------------- E-mail
# log    = scrive il messaggio in storage/mail/ senza inviarlo (prototipo)
# mail   = funzione mail() di PHP (disponibile su Hostinger)
# smtp   = SMTP autenticato (consigliato in produzione)
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Arco del Vento"
# Dove arrivano le richieste di prenotazione e i messaggi dei moduli.
# Più indirizzi: separati da virgola, per esempio info@dominio.it, altro@dominio.it
# Se nell'area riservata (Ricezione e-mail) si scelgono indirizzi, valgono quelli.
MAIL_TO_ADDRESS=no-reply@example.test
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=tls
