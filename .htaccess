# Arco del Vento — .htaccess della radice del progetto.
#
# Serve SOLO se tutto il progetto viene caricato dentro public_html, che è la
# strada più rapida via FTP. Manda ogni richiesta dentro public/ e impedisce
# che le cartelle dell'applicazione siano raggiungibili dal web.
#
# Funziona uguale alla radice di un dominio e in una sottocartella — per
# esempio blackout.in/assisiapartment/ durante la prova: nessuna regola scrive
# un percorso che cominci con «/». La cartella del sito la conosce PHP, da
# APP_URL nel file .env. Vedi docs/DEPLOY-HOSTINGER.md.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS prima di tutto: farlo qui evita un giro in più rispetto a lasciarlo
  # all'.htaccess dentro public/, che verrebbe letto solo dopo la riscrittura.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL}   !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Le cartelle dell'applicazione non si servono mai.
  RewriteRule ^(src|views|content|config|storage|database|tools|docs)/ - [F,L]

  # Tutto il resto entra in public/. Un indirizzo che contiene già /public/
  # non passa di qui: lo prende l'.htaccess di public/, che lo rimanda a
  # quello pulito.
  RewriteCond $1 !^public(/|$)
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(\.env|\.env\..*|\.user\.ini|composer\.(json|lock)|.*\.md|.*\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
