// ========================================================= translation ======

/// Polymorphic, per field path, per locale, with state. A database trigger
/// refuses to let machine output overwrite reviewed or published work - see
/// schema.sql and docs/11.
model Translation {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  guideId          String?   @map("guide_id") @db.Uuid
  translatableType String    @map("translatable_type")
  translatableId   String    @map("translatable_id") @db.Uuid
  fieldPath        String    @map("field_path")
  locale           String
  sourceLocale     String    @map("source_locale")
  valueText        String?   @map("value_text")
  proposedValue    String?   @map("proposed_value")
  status           String    @default("missing") // missing|machine_translated|reviewed|published
  sourceHash       String?   @map("source_hash")
  isStale          Boolean   @default(false) @map("is_stale")
  isLocked         Boolean   @default(false) @map("is_locked")
  engine           String?
  engineMeta       Json?     @map("engine_meta")
  translatedAt     DateTime? @map("translated_at") @db.Timestamptz
  reviewedBy       String?   @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  guide        Guide?  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  targetLocale Locale  @relation("TranslationTarget", fields: [locale], references: [code])
  origin       Locale  @relation("TranslationSource", fields: [sourceLocale], references: [code])

  @@unique([translatableType, translatableId, fieldPath, locale])
  @@index([translatableType, translatableId, locale])
  @@index([guideId, locale, status])
  @@map("translations")
}

// ========================================================== publishing ======

/// Slug history. Old rows become permanent redirects and are never deleted or
/// reused. See docs/13.
model PublicUrl {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  guideId      String    @map("guide_id") @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  host         String    @default("welcome.myhouse.it")
  slug         String
  isPrimary    Boolean   @default(true) @map("is_primary")
  status       String    @default("active") // active|redirect
  redirectToId String?   @map("redirect_to_id") @db.Uuid
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  guide      Guide       @relation(fields: [guideId], references: [id], onDelete: Cascade)
  redirectTo PublicUrl?  @relation("UrlRedirect", fields: [redirectToId], references: [id])
  redirects  PublicUrl[] @relation("UrlRedirect")

  @@unique([host, slug])
  @@map("public_urls")
}

/// The token is permanent. The QR encodes mh.li/q/<token>, never the guide URL,
/// so printed codes survive slug changes and custom domains. See docs/13.
model QrCode {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  guideId       String    @map("guide_id") @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  token         String    @unique
  label         String?
  styleJson     Json      @default("{}") @map("style_json")
  scanCount     BigInt    @default(0) @map("scan_count")
  lastScannedAt DateTime? @map("last_scanned_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy     String?   @map("revoked_by") @db.Uuid

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@map("qr_codes")
}

// =========================================================== analytics ======

/// Partitioned monthly in schema.sql - Prisma does not model partitioning, so
/// partition maintenance lives in SQL migrations.
model AnalyticsDaily {
  id         String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  guideId    String @map("guide_id") @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  date       DateTime @db.Date
  metric     String
  dimension  String?
  dimension2 String? @map("dimension_2")
  count      BigInt @default(0)

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, date, metric, dimension, dimension2])
  @@index([guideId, date(sort: Desc)])
  @@map("analytics_daily")
}

