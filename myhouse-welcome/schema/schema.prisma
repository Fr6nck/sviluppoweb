  note          String?
  publishedBy   String?  @map("published_by") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz

  guide      Guide   @relation("GuideVersions", fields: [guideId], references: [id], onDelete: Cascade)
  publishedOn Guide[] @relation("PublishedVersion")

  @@unique([guideId, versionNumber])
  @@map("guide_versions")
}

model SectionTemplate {
