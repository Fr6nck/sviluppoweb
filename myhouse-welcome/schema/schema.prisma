// =============================================================================
// MyHouse Welcome — Prisma schema
//
// The application-layer mirror of schema.sql. schema.sql is the source of truth:
// it carries the CHECK constraints, partial indexes, triggers and row-level
// security policies that Prisma cannot express, and it is the file that was
// verified against PostgreSQL 16 (see tests.sql). Migrations are written as SQL
// and this file is kept in step with them.
//
// Unlike schema.sql, this file has NOT been machine-validated - npm was
// unavailable in the environment it was written in. Run `prisma validate`
// before relying on it.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, pg_trgm]
}

// ============================================================ identity =======

model User {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email             String    @db.Citext
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz
  passwordHash      String?   @map("password_hash") // null between purchase and activation
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz
  fullName          String?   @map("full_name")
  phone             String?
  locale            String    @default("it-IT")
  timezone          String    @default("Europe/Rome")
  avatarMediaId     String?   @map("avatar_media_id") @db.Uuid
  status            String    @default("pending") // pending|active|suspended|locked
  mfaSecret         String?   @map("mfa_secret")
  mfaEnabledAt      DateTime? @map("mfa_enabled_at") @db.Timestamptz
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp       String?   @map("last_login_ip") @db.Inet
  termsAcceptedAt   DateTime? @map("terms_accepted_at") @db.Timestamptz
  marketingOptIn    Boolean   @default(false) @map("marketing_opt_in")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  avatar       Media?                  @relation("UserAvatar", fields: [avatarMediaId], references: [id])
  roles        UserRole[]
  memberships  AccountMember[]
  authTokens   AuthToken[]
  activity     ActivityLog[]
  impersonations ImpersonationSession[]
  uploads      Media[]                 @relation("MediaUploader")

  @@unique([email])
  @@index([status])
  @@map("users")
}

model Account {
  id                  String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  reference           String    @unique // MH-2026-0341
  name                String
  type                String    @default("individual") // individual|company
  legalName           String?   @map("legal_name")
  vatNumber           String?   @map("vat_number")  // Partita IVA
  taxCode             String?   @map("tax_code")    // Codice fiscale
  sdiCode             String?   @map("sdi_code")    // Codice destinatario SDI
  pecEmail            String?   @map("pec_email") @db.Citext
  billingEmail        String    @map("billing_email") @db.Citext
  billingAddressLine1 String?   @map("billing_address_line1")
  billingAddressLine2 String?   @map("billing_address_line2")
  billingCity         String?   @map("billing_city")
  billingPostalCode   String?   @map("billing_postal_code")
  billingProvince     String?   @map("billing_province")
  billingCountry      String    @default("IT") @map("billing_country") @db.Char(2)
  stripeCustomerId    String?   @unique @map("stripe_customer_id")
  packageVersionId    String?   @map("package_version_id") @db.Uuid
  status              String    @default("pending") // pending|active|suspended|archived
  statusReason        String?   @map("status_reason")
  suspendedAt         DateTime? @map("suspended_at") @db.Timestamptz
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz
  activatedAt         DateTime? @map("activated_at") @db.Timestamptz
  locale              String    @default("it-IT")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  packageVersion  PackageVersion?        @relation(fields: [packageVersionId], references: [id])
  members         AccountMember[]
  userRoles       UserRole[]
  properties      Property[]
  guides          Guide[]
  orders          Order[]
  payments        Payment[]
  invoices        Invoice[]
  subscriptions   Subscription[]
  entitlements    Entitlement[]
  media           Media[]
  translations    Translation[]
  notes           AdminNote[]
  activity        ActivityLog[]
  impersonations  ImpersonationSession[]
  onboarding      OnboardingProgress[]

  @@index([status, createdAt(sort: Desc)])
  @@map("accounts")
}

model Role {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key         String  @unique
  name        String
  description String?
  scope       String // platform|account
  isSystem    Boolean @default(true) @map("is_system")

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key         String @unique // 'guide.publish'
  description String
  domain      String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// account_id NULL means platform scope (MyHouse staff).
model UserRole {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  accountId String?   @map("account_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id])
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@map("user_roles")
}

model AccountMember {
  id         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleKey    String    @map("role_key") // account_owner|account_editor
  invitedBy  String?   @map("invited_by") @db.Uuid
  invitedAt  DateTime? @map("invited_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_members")
}

model AuthToken {
  id         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String // activation|email_verification|password_reset|email_change
  tokenHash  String    @unique @map("token_hash") // SHA-256; the token itself is never stored
  payload    Json?
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdIp  String?   @map("created_ip") @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ================================================ catalog and entitlements ===

model Feature {
  id           String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key          String  @unique // 'welcome.languages.max'
  name         String
  description  String?
  category     String
  valueType    String  @map("value_type") // boolean|limit|enum
  defaultValue Json    @map("default_value")
  enumOptions  Json?   @map("enum_options")
  sortOrder    Int     @default(0) @map("sort_order")
  isVisible    Boolean @default(true) @map("is_visible")

  packageFeatures PackageFeature[]
  entitlements    Entitlement[]

  @@map("features")
}

model Package {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key           String   @unique // essential|plus|pro
  name          String
  tagline       String?
  description   String?
  sortOrder     Int      @default(0) @map("sort_order")
  isPublic      Boolean  @default(true) @map("is_public")
  isRecommended Boolean  @default(false) @map("is_recommended")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  versions PackageVersion[]

  @@map("packages")
}

/// Immutable once sold. is_frozen is enforced by a database trigger - see
/// schema.sql and docs/05. This is how existing customers keep what they bought.
model PackageVersion {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  packageId       String    @map("package_id") @db.Uuid
  version         Int
  amountCents     BigInt    @map("amount_cents")
  currency        String    @default("EUR") @db.Char(3)
  billingInterval String    @default("one_time") @map("billing_interval")
  stripeProductId String?   @map("stripe_product_id")
  stripePriceId   String?   @unique @map("stripe_price_id")
  changelog       String?
  effectiveFrom   DateTime  @default(now()) @map("effective_from") @db.Timestamptz
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz
  isCurrent       Boolean   @default(false) @map("is_current")
  isFrozen        Boolean   @default(false) @map("is_frozen")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  package       Package          @relation(fields: [packageId], references: [id])
  features      PackageFeature[]
  accounts      Account[]
  orders        Order[]
  entitlements  Entitlement[]
  subscriptions Subscription[]

  @@unique([packageId, version])
  @@map("package_versions")
}

model PackageFeature {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  packageVersionId String   @map("package_version_id") @db.Uuid
  featureId        String   @map("feature_id") @db.Uuid
  valueJson        Json     @map("value_json") // true | 5 | -1 | "editorial"
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  packageVersion PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  feature        Feature        @relation(fields: [featureId], references: [id])

  @@unique([packageVersionId, featureId])
  @@map("package_features")
}

/// Resolved grants. Several rows per (account, feature) are expected - package,
/// override, promo. Resolution order: override > promo > package > feature default.
model Entitlement {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  featureKey       String    @map("feature_key")
  valueJson        Json      @map("value_json")
  source           String // package|override|promo|grandfathered
  packageVersionId String?   @map("package_version_id") @db.Uuid
  reason           String?
  grantedBy        String?   @map("granted_by") @db.Uuid
  startsAt         DateTime  @default(now()) @map("starts_at") @db.Timestamptz
  endsAt           DateTime? @map("ends_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy        String?   @map("revoked_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  feature        Feature         @relation(fields: [featureKey], references: [key])
  packageVersion PackageVersion? @relation(fields: [packageVersionId], references: [id])

  @@index([accountId, featureKey])
  @@map("entitlements")
}

// ============================================================ commerce =======

model Order {
  id                      String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  reference               String    @unique
  accountId               String?   @map("account_id") @db.Uuid
  packageVersionId        String    @map("package_version_id") @db.Uuid
  type                    String    @default("purchase") // purchase|upgrade|manual|renewal
  status                  String    @default("created")
  currency                String    @default("EUR") @db.Char(3)
  subtotalCents           BigInt    @default(0) @map("subtotal_cents")
  discountCents           BigInt    @default(0) @map("discount_cents")
  taxCents                BigInt    @default(0) @map("tax_cents")
  totalCents              BigInt    @default(0) @map("total_cents")
  discountCodeId          String?   @map("discount_code_id") @db.Uuid
  paymentProvider         String    @default("stripe") @map("payment_provider")
  stripeCheckoutSessionId String?   @unique @map("stripe_checkout_session_id")
  customerEmail           String?   @map("customer_email") @db.Citext
  customerLocale          String?   @map("customer_locale")
  manualReason            String?   @map("manual_reason")
  createdBy               String?   @map("created_by") @db.Uuid
  placedAt                DateTime  @default(now()) @map("placed_at") @db.Timestamptz
  completedAt             DateTime? @map("completed_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  account        Account?             @relation(fields: [accountId], references: [id])
  packageVersion PackageVersion       @relation(fields: [packageVersionId], references: [id])
  discountCode   DiscountCode?        @relation(fields: [discountCodeId], references: [id])
  payments       Payment[]
  invoices       Invoice[]
  redemptions    DiscountRedemption[]
  webhookEvents  WebhookEvent[]

  @@index([accountId, placedAt(sort: Desc)])
  @@index([status, placedAt(sort: Desc)])
  @@map("orders")
}

model Payment {
  id                    String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId               String    @map("order_id") @db.Uuid
  accountId             String?   @map("account_id") @db.Uuid
  stripePaymentIntentId String?   @unique @map("stripe_payment_intent_id")
  stripeChargeId        String?   @map("stripe_charge_id")
  status                String    @default("pending")
  amountCents           BigInt    @map("amount_cents")
  currency              String    @default("EUR") @db.Char(3)
  refundedAmountCents   BigInt    @default(0) @map("refunded_amount_cents")
  methodType            String?   @map("method_type")
  methodBrand           String?   @map("method_brand")
  methodLast4           String?   @map("method_last4") @db.Char(4)
  receiptUrl            String?   @map("receipt_url")
  failureCode           String?   @map("failure_code")
  failureMessage        String?   @map("failure_message")
  paidAt                DateTime? @map("paid_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  order   Order    @relation(fields: [orderId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  stripeRefundId String?  @unique @map("stripe_refund_id")
  amountCents    BigInt   @map("amount_cents")
  currency       String   @default("EUR") @db.Char(3)
  reason         String
  status         String   @default("pending")
  initiatedBy    String?  @map("initiated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model Invoice {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  orderId         String?   @map("order_id") @db.Uuid
  stripeInvoiceId String?   @unique @map("stripe_invoice_id")
  number          String?
  amountCents     BigInt    @map("amount_cents")
  currency        String    @default("EUR") @db.Char(3)
  status          String    @default("draft")
  pdfUrl          String?   @map("pdf_url")
  hostedUrl       String?   @map("hosted_url")
  issuedAt        DateTime? @map("issued_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@map("invoices")
}

/// Dormant until recurring packages ship. Present so that enabling them is a
/// data change and a Stripe mode, not a migration. See docs/06.
model Subscription {
  id                   String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId            String    @map("account_id") @db.Uuid
  packageVersionId     String    @map("package_version_id") @db.Uuid
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  status               String    @default("active")
  currentPeriodStart   DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at") @db.Timestamptz
  trialEnd             DateTime? @map("trial_end") @db.Timestamptz
  graceUntil           DateTime? @map("grace_until") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  account        Account        @relation(fields: [accountId], references: [id])
  packageVersion PackageVersion @relation(fields: [packageVersionId], references: [id])

  @@map("subscriptions")
}

model DiscountCode {
  id                    String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code                  String
  description           String?
  type                  String // percent|amount
  value                 Int
  currency              String?   @db.Char(3)
  stripeCouponId        String?   @map("stripe_coupon_id")
  stripePromotionCodeId String?   @map("stripe_promotion_code_id")
  appliesToPackageIds   Json?     @map("applies_to_package_ids")
  maxRedemptions        Int?      @map("max_redemptions")
  redeemedCount         Int       @default(0) @map("redeemed_count")
  startsAt              DateTime? @map("starts_at") @db.Timestamptz
  endsAt                DateTime? @map("ends_at") @db.Timestamptz
  status                String    @default("active")
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  orders      Order[]
  redemptions DiscountRedemption[]

  @@map("discount_codes")
}

model DiscountRedemption {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  discountCodeId String   @map("discount_code_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  accountId      String?  @map("account_id") @db.Uuid
  amountCents    BigInt   @map("amount_cents")
  redeemedAt     DateTime @default(now()) @map("redeemed_at") @db.Timestamptz

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, orderId])
  @@map("discount_redemptions")
}

/// The unique index on (provider, providerEventId) IS the idempotency mechanism.
/// Never remove it. See docs/06.
model WebhookEvent {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider        String    @default("stripe")
  providerEventId String    @map("provider_event_id")
  type            String
  apiVersion      String?   @map("api_version")
  payload         Json
  status          String    @default("received")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  relatedOrderId  String?   @map("related_order_id") @db.Uuid
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt     DateTime? @map("processed_at") @db.Timestamptz

  relatedOrder Order? @relation(fields: [relatedOrderId], references: [id])

  @@unique([provider, providerEventId])
  @@index([status, receivedAt(sort: Desc)])
  @@map("webhook_events")
}

// ============================================================== media =======

model Media {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  uploadedBy       String?   @map("uploaded_by") @db.Uuid
  kind             String // image|pdf
  originalFilename String    @map("original_filename")
  storageKey       String    @map("storage_key")
  mimeType         String    @map("mime_type")
  detectedMime     String?   @map("detected_mime") // sniffed from magic bytes
  bytes            BigInt
  width            Int?
  height           Int?
  pageCount        Int?      @map("page_count")
  checksumSha256   String    @map("checksum_sha256")
  dominantColor    String?   @map("dominant_color") @db.Char(7)
  blurPlaceholder  String?   @map("blur_placeholder")
  altText          String?   @map("alt_text")
  title            String?
  focalX           Float?    @map("focal_x")
  focalY           Float?    @map("focal_y")
  status           String    @default("uploading")
  failureReason    String?   @map("failure_reason")
  scanStatus       String    @default("pending") @map("scan_status")
  processedAt      DateTime? @map("processed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  account         Account          @relation(fields: [accountId], references: [id])
  uploader        User?            @relation("MediaUploader", fields: [uploadedBy], references: [id])
  variants        MediaVariant[]
  usages          MediaUsage[]
  avatarOf        User[]           @relation("UserAvatar")
  propertyLogos   Property[]       @relation("PropertyLogo")
  propertyCovers  Property[]       @relation("PropertyCover")
  propertyHosts   Property[]       @relation("PropertyHostPhoto")
  contentBlocks   ContentBlock[]
  recommendations Recommendation[]

  @@index([accountId, createdAt(sort: Desc)])
  @@map("media")
}

model MediaVariant {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  mediaId    String   @map("media_id") @db.Uuid
  purpose    String // thumb|card|content|cover|cover2x
  format     String // avif|webp|jpeg
  width      Int
  height     Int
  bytes      BigInt
  storageKey String   @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, purpose, format])
  @@map("media_variants")
}

/// Written by the same service call that sets a media reference, so it cannot
/// drift. This is what makes deletion safe and quotas honest. See docs/12.
model MediaUsage {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  mediaId    String   @map("media_id") @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  usableType String   @map("usable_type")
  usableId   String   @map("usable_id") @db.Uuid
  field      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, usableType, usableId, field])
  @@index([usableType, usableId])
  @@map("media_usages")
}

