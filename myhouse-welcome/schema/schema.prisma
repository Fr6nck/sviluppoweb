  actorUserId            String?  @map("actor_user_id") @db.Uuid
  actorType              String   @default("user") // user|admin|system|webhook
  actorLabel             String?  @map("actor_label") // survives user deletion
  accountId              String?  @map("account_id") @db.Uuid
  impersonationSessionId String?  @map("impersonation_session_id") @db.Uuid
  action                 String
  subjectType            String?  @map("subject_type")
  subjectId              String?  @map("subject_id") @db.Uuid
  subjectLabel           String?  @map("subject_label")
