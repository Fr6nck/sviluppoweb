  accountId             String    @map("account_id") @db.Uuid
  status                String    @default("draft") // draft|published|unpublished
  defaultLocale         String    @default("it-IT") @map("default_locale")
  publishedVersionId    String?   @map("published_version_id") @db.Uuid
  hasUnpublishedChanges Boolean   @default(false) @map("has_unpublished_changes")
  completionPercent     Int       @default(0) @map("completion_percent") @db.SmallInt
  searchEnabled         Boolean   @default(false) @map("search_enabled")
  seoIndexable          Boolean   @default(false) @map("seo_indexable")
  themeJson             Json      @default("{}") @map("theme_json")
  brandingJson          Json      @default("{}") @map("branding_json")
  welcomeMessage        String?   @map("welcome_message")
  publishedAt           DateTime? @map("published_at") @db.Timestamptz
  publishedBy           String?   @map("published_by") @db.Uuid
  unpublishedAt         DateTime? @map("unpublished_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz

