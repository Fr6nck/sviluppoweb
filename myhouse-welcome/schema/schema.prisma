  defaultCopy     Json     @default("{}") @map("default_copy")
  isSystem        Boolean  @default(true) @map("is_system")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  sections GuideSection[]

  @@map("section_templates")
}

model GuideSection {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  guideId           String    @map("guide_id") @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  sectionTemplateId String?   @map("section_template_id") @db.Uuid
  key               String
  type              String    @default("standard") // standard|custom
  title             String
  subtitle          String?
  icon              String    @default("circle")
  sortOrder         Int       @default(0) @map("sort_order")
  isEnabled         Boolean   @default(true) @map("is_enabled")
  isComplete        Boolean   @default(false) @map("is_complete")
  visibility        String    @default("public") // public|pin_protected|date_window
  pinHash           String?   @map("pin_hash") // Argon2id; never the PIN itself
  visibleFrom       DateTime? @map("visible_from") @db.Timestamptz
  visibleTo         DateTime? @map("visible_to") @db.Timestamptz
  requiredFeature   String?   @map("required_feature")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  guide    Guide            @relation(fields: [guideId], references: [id], onDelete: Cascade)
  template SectionTemplate? @relation(fields: [sectionTemplateId], references: [id])
  blocks   ContentBlock[]

  @@unique([guideId, key])
  @@index([guideId, sortOrder])
  @@map("guide_sections")
}

/// `data` is the only varying part - a versioned JSON Schema validates it on
/// write. Which block, where, and whether it is on stays relational. See docs/14.
model ContentBlock {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  guideSectionId String    @map("guide_section_id") @db.Uuid
  guideId        String    @map("guide_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  type           String
  schemaVersion  Int       @default(1) @map("schema_version") @db.SmallInt
  sortOrder      Int       @default(0) @map("sort_order")
  isEnabled      Boolean   @default(true) @map("is_enabled")
  isSensitive    Boolean   @default(false) @map("is_sensitive")
  data           Json      @default("{}")
  mediaId        String?   @map("media_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  section GuideSection @relation(fields: [guideSectionId], references: [id], onDelete: Cascade)
  guide   Guide        @relation(fields: [guideId], references: [id], onDelete: Cascade)
  media   Media?       @relation(fields: [mediaId], references: [id])

  @@index([guideSectionId, sortOrder])
  @@map("content_blocks")
}

