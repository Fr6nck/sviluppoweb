# Arco del Vento — Apache (Hostinger usa Apache con LiteSpeed: le direttive
# qui sotto sono supportate da entrambi).
#
# Questo file sta nella cartella servita al pubblico. Su Hostinger:
# il contenuto di public/ va in public_html/, e le cartelle src/, views/,
# content/, config/, storage/ restano FUORI da public_html.
# Se invece si carica tutto il progetto dentro public_html, ci pensa
# l'.htaccess nella radice del progetto.

# --------------------------------------------------------------- indirizzi
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS sempre. Su Hostinger il certificato è incluso e si attiva dal
  # pannello: appena è attivo, questa regola manda lì ogni richiesta.
  # La condizione guarda anche X-Forwarded-Proto perché dietro il proxy di
  # LiteSpeed la variabile HTTPS può restare vuota su una richiesta cifrata,
  # e senza quel controllo il sito entrerebbe in un ciclo di redirezioni.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL}   !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # /public/… non è un indirizzo del sito: se qualcuno ci arriva — un link
  # copiato male, un vecchio segnalibro — torna a quello pulito. Senza, ogni
  # pagina avrebbe due indirizzi. Sta qui e non nell'.htaccess della radice
  # perché una richiesta che entra in public/ legge solo questo file.
  # THE_REQUEST è la riga di richiesta originale: tiene la cartella del sito
  # (/assisiapartment in prova) e non viene toccata dalle riscritture.
  RewriteCond %{THE_REQUEST} ^\S+\s([^\s?]*?)/public/([^\s?]*)
  RewriteRule ^ %1/%2 [R=301,L,NE]

  # Una barra finale in meno: /it/camere/ e /it/camere sono la stessa pagina,
  # e due indirizzi per una pagina sola sono contenuto duplicato.
  # La home di lingua (/it/) invece TIENE la barra, che è il suo indirizzo:
  # la regola di prima la toglieva anche a lei, e ogni visita partiva con due
  # reindirizzamenti — / → /it/ → /it — verso un indirizzo diverso da quello
  # dichiarato in canonical. Il percorso si legge su THE_REQUEST, così il
  # reindirizzamento resta dentro la cartella del sito ovunque stia.
  # Si cattura solo il percorso: la parte dopo «?» la riattacca Apache da sé.
  # Metterla nella destinazione da un riferimento fa rispondere 403 agli
  # Apache recenti, che lo trattano come un tentativo di iniezione.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{THE_REQUEST} !^\S+\s[^\s?]*/[a-z]{2}/[\s?]
  RewriteCond %{THE_REQUEST} ^\S+\s([^\s?]*[^/\s?])/+[\s?]
  RewriteRule ^ %1 [R=301,L,NE]

  # Tutto quello che non è un file o una cartella reale va al front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# ------------------------------------------------------------- compressione
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------- cache
<IfModule mod_expires.c>
  ExpiresActive On

  # I caratteri non cambiano mai: un anno, e immutable.
  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fogli di stile e script portano ?v=<data di modifica> nell'indirizzo:
  # possono stare in cache a lungo, perché al cambio cambia l'indirizzo.
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"

  ExpiresByType image/webp               "access plus 6 months"
  ExpiresByType image/jpeg               "access plus 6 months"
  ExpiresByType image/png                "access plus 6 months"
  ExpiresByType image/svg+xml            "access plus 6 months"

  # L'HTML no: è generato, e deve poter cambiare subito.
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # I caratteri servono anche a una pagina su un sottodominio diverso.
  <FilesMatch "\.(woff2|woff)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------- sicurezza
# Niente elenco dei file quando manca un index.
Options -Indexes

# I file che non devono mai essere serviti, anche se qualcuno li carica per
# sbaglio nella cartella pubblica.
<FilesMatch "^(\.env|\.env\..*|\.user\.ini|composer\.(json|lock)|.*\.md|.*\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --------------------------------------------------------------------- MIME
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# --------------------------------------------------------- pagine d'errore
# Il 404 lo disegna l'applicazione e resta nella lingua dell'indirizzo
# sbagliato: ci arriva già da solo, perché le riscritture mandano al front
# controller tutto ciò che non è un file vero.
# Il 500 lo mostra public/index.php, che usa 500.html e sa in che cartella
# sta il sito. Qui resta solo il caso in cui PHP non parte proprio: una riga
# di testo invece di un percorso, perché ErrorDocument vuole un indirizzo
# fisso dalla radice del dominio — «/500.html» — che in una sottocartella
# punterebbe alla pagina di errore di un altro sito.
ErrorDocument 500 "Arco del Vento: il sito non risponde. Riprova tra qualche minuto."
ErrorDocument 503 "Arco del Vento: il sito non risponde. Riprova tra qualche minuto."

DirectoryIndex index.php
